# ===========================================================================
# StockGambling - example environment file
# ===========================================================================
# Copy to `.env` and adjust. NEVER commit a real `.env` (it is git-ignored).
# Docker Compose overrides the hostnames below so the exact same file works
# for both local (non-Docker) runs and in-container runs.
# ===========================================================================

# --- Application -----------------------------------------------------------
APP_NAME=stockgambling-api
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console            # console | json
API_PREFIX=/api/v1
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Docs are always exposed; set DOCS_ENABLED=false to hard-disable them.
DOCS_ENABLED=true

# --- PostgreSQL ------------------------------------------------------------
# Use `localhost` when running the API on the host, `postgres` when running
# it inside Docker Compose (compose sets this automatically).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stockgambling
POSTGRES_USER=stockgambling
# Local-only placeholder. Generate a real password before any deployment.
POSTGRES_PASSWORD=change-me-local-only
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5
# Optional full override; when set it takes precedence over the parts above.
# DATABASE_URL=postgresql+psycopg://stockgambling:change-me-local-only@localhost:5432/stockgambling

# --- Redis -----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=5
CELERY_RESULT_BACKEND_DB=1

# --- Worker ----------------------------------------------------------------
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_ALWAYS_EAGER=false

# --- Market data providers (Phase 3+, leave blank for now) -----------------
# The application depends on provider *interfaces*, never on a concrete vendor.
# Provider credentials are never stored in the database or in git.
CEDEAR_METADATA_PROVIDER=
UNDERLYING_PROVIDER=
UNDERLYING_PROVIDER_API_KEY=
FX_PROVIDER=
FX_PROVIDER_API_KEY=
